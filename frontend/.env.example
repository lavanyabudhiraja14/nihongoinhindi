# Server-Side Backend URL (Used only by Next.js rewrites to proxy /api/* and /health)
# NEVER use NEXT_PUBLIC_ for this variable to prevent exposing backend addresses to client bundles.
#
# Local Development default:
BACKEND_URL="http://127.0.0.1:8000"
#
# Production Example (Vercel deployment connecting to Render/Railway backend):
# BACKEND_URL="https://your-backend-app.onrender.com"
